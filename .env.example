# ==============================================================================
# КОНФИГУРАЦИЯ ПОДКЛЮЧЕНИЯ К LLM GEMMA 4 12B (ALFA-HACK 2026)
# ==============================================================================
# По умолчанию backend/scoring ходят к LLM напрямую по AI_BASE_URL.
# WireGuard-прокси (llm-proxy) — ОПЦИОНАЛЬНЫЙ: он поднимается только с профилем
# "wireguard" и при заданном WG_PRIVATE_KEY. Не запускайте туннель одновременно
# на двух машинах с одним ключом.

# Оставьте пустым для прямого доступа к LLM. Заполните, чтобы включить прокси.
WG_PRIVATE_KEY=
WG_ADDRESS=10.154.53.14/16
WG_PEER_PUBLIC_KEY=81kxTfIHmSpiPMZdeEBakD0w1seqr+C27aQePY2D0F4=
WG_ENDPOINT=93.190.110.225:56598

# Пусто = авто: через llm-proxy при заданном WG_PRIVATE_KEY, иначе напрямую.
# Можно задать явно, например http://10.154.0.1:8080/v1
AI_BASE_URL=
AI_MODEL=gemma4:12b
SCORING_AI_TIMEOUT=30.0

# ==============================================================================
# БАЗОВЫЕ НАСТРОЙКИ СЕРВЕРА И БАЗЫ ДАННЫХ
# ==============================================================================
SERVER_ADDR=0.0.0.0
SERVER_PORT=8080
PORT=8080
GIN_MODE=release

# Публичный HTTP-порт фронтенда (fortis-ss.ru)
FRONTEND_PORT=80

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=alfa
DB_PASSWORD=alfa_2026
DB_NAME=alfa_credit
DB_SSLMODE=disable

# JWT Authentication (min 32 bytes)
JWT_SECRET=local-demo-only-change-this-secret-32-bytes

# AI API Parameters
AI_API_KEY=
AI_TIMEOUT=30

# ML Scoring Service
SCORING_BASE_URL=http://scoring:8000
SCORING_PORT=8000
DSTI_APPROVE_MAX=0.35
DSTI_COUNTER_MAX=0.55
