FROM alpine:3.22

RUN apk add --no-cache wireguard-tools wireguard-go socat iproute2 iptables

COPY scripts/llm-proxy-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=5 \
    CMD wg show wg0 >/dev/null && nc -z 127.0.0.1 8080

ENTRYPOINT ["/entrypoint.sh"]
